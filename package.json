{
  "name": "helix-paradox",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=api",
    "dev:web": "turbo run dev --filter=web",
    "build": "turbo run build",
    "check": "turbo run check",
    "deploy": "pnpm --filter api deploy && pnpm --filter web deploy"
  },
  "devDependencies": {
    "turbo": "^2.11.10"
  },
  "packageManager": "pnpm@12.9.1"
}
