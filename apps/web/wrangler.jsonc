{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "helix-paradox-website",
	"compatibility_date": "2026-10-23",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": { "enabled": true },
	// Public: Cloudflare Turnstile's site key for the sign-up check (src/env.ts). Its secret is the
	// API's TURNSTILE_SECRET_KEY. Replace with the key from Dashboard > Turnstile.
	// WEB_ANALYTICS_TOKEN: Cloudflare Web Analytics (no cookies); empty turns it off.
	"vars": { "TURNSTILE_SITE_KEY": "0x4AAAAAAFx8Hy0GTRnb0RvE", "WEB_ANALYTICS_TOKEN": "f3ab62d1374646ec8a8f9663a0ba54" },
	// Serve the site on its own domain (wrangler creates the DNS record and certificate on deploy).
	// www is redirected to the apex by a Cloudflare redirect rule, so Better Auth only sees one origin.
	"routes": [{ "pattern": "helixparadox.com", "custom_domain": true }],
	// No *.workers.dev copy of the site: it would split links and search results, and sign-in
	// there fails anyway because BETTER_AUTH_URL is the custom domain.
	"workers_dev": false,
	"preview_urls": false,
	// /api/* is forwarded to the Hono worker over this binding (see src/hooks.server.ts).
	"services": [{ "binding": "API", "service": "helix-paradox-api" }]
}
