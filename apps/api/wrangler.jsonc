{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "helix-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": { "enabled": true },
  "vars": {
    // Public origin of the SvelteKit site. The site proxies /api/* to this worker,
    // so auth cookies are first-party on this origin.
    "BETTER_AUTH_URL": "http://localhost:5173"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "helix-db",
      // Replace with the id printed by `wrangler d1 create helix-db` before deploying.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "helix-images"
    }
  ]
}
