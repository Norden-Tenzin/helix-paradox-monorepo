{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "helix-paradox-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": { "enabled": true },
  // Run the worker near its D1 database rather than near each visitor: every page makes a few
  // queries, and each one would otherwise cross the world. Only applies once deployed.
  "placement": { "mode": "smart" },
  "vars": {
    "BETTER_AUTH_URL": "https://helixparadox.com",
    "EMAIL_FROM": "noreply@mail.helixparadox.com"
  },
  // Cloudflare Email Service. "remote": wrangler dev reaches the real service too, but local dev
  // prints emails instead of sending them (src/email.ts).
  "send_email": [{ "name": "EMAIL", "remote": true }],
  // Request limits (src/rate-limit.ts). namespace_id is any number unique to this account.
  // period is 10 or 60 seconds.
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "UPLOAD_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
    { "name": "WRITE_LIMITER", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "helix-db",
      "database_id": "855c8942-7646-4f81-8e05-55ddafa174c5",
      "migrations_dir": "migrations",
      "remote": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "helix-images",
      "remote": true
    }
  ]
}
