{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "helix-paradox-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": { "enabled": true },
  "vars": {
    "BETTER_AUTH_URL": "https://helix-paradox-website.nordentenzin29.workers.dev/"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "helix-db",
      "database_id": "855c8942-7646-4f81-8e05-55ddafa174c5",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "helix-images"
    }
  ]
}
