{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".svelte-kit/cloudflare/**", ".svelte-kit/output/**"]
    },
    "check": {
      "dependsOn": ["^check"]
    }
  }
}
